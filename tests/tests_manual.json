
{
  "tests": [
    {
      "test_id": "T1",
      "requirement_id": "FR1",
      "scenario": "Subscription Terms Explicitly Displayed Before Free-Trial",
      "steps": [
        "Open the Calm app and navigate to the sign-up page",
        "Proceed to the payment page",
        "Look on the payment page for billing details"
      ],
      "expected_result": "The exact billing details including amount, frequency, and relevant dates are clearly displayed on the payment page before confirmation of subscription.  "
    },
    {
      "test_id": "T2",
      "requirement_id": "FR1",
      "scenario": "Subscription Terms Not Hidden",
      "steps": [
        "Open the Calm app and navigate to the sign-up page",
        "Proceed to the payment page without clicking any additional dialogue",
        "Check to see if billing details are visible by default where no user input is required to find them on the payment page.  "
      ],
      "expected_result": "Billing details are visible on default on the payment page without any user input"
    },
    {
      "test_id": "T3",
      "requirement_id": "FR2",
      "scenario": "No Automatic Subscription Sign-Up After Free Trial Period",
      "steps": [
        "Sign-up for a free trial",
        "Allow free trial period to end naturally",
        "Check the users account for a subscription status"
      ],
      "expected_result": ""
    },
    {
      "test_id": "T4",
      "requirement_id": "FR2",
      "scenario": "User Explicitly Confirms Subscription Sign-Up",
      "steps": [
        "Sign-up for the free trial",
        "Let the free trial end",
        "Observe whether the system prompts the user to confirm a payment to continue services.  "
      ],
      "expected_result": "The system clearly presents the user with an explicit subscription prompt where the user must confirm before the subscription is paid.  "
    },
